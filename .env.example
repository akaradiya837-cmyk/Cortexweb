NODE_ENV=development
PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=cortexweb
MYSQL_USER=cortexweb_app
MYSQL_PASSWORD=replace-with-your-database-password
MYSQL_CONNECTION_LIMIT=10
DATABASE_ENCRYPTION_KEY=replace-with-a-random-64-character-hex-key
HOSTED_MYSQL_HOST=
HOSTED_MYSQL_PORT=3306
HOSTED_MYSQL_USER=
HOSTED_MYSQL_PASSWORD=
HOSTED_MYSQL_SSL=false
HOSTED_MYSQL_USER_HOST=localhost
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=CortexWeb <no-reply@example.com>
